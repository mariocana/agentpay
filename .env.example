# Network: "testnet" (default, Arc Testnet 5042002) or "mainnet" (Arc 5042).
ARC_NETWORK=testnet
# Optional RPC override (defaults to the viem chain RPC)
# ARC_RPC_URL=

# Two EOAs. Fund both with Arc Testnet USDC from https://faucet.circle.com
# (USDC is also the gas token on Arc). Generate keys with: npm run keygen
CLIENT_PRIVATE_KEY=0x
WORKER_PRIVATE_KEY=0x

# Set after `npm run register` (ERC-8004 agent id of the worker)
WORKER_AGENT_ID=

# Only needed on mainnet after `npm run deploy:erc8183` (testnet uses the Circle reference deployment)
# ERC8183_ADDRESS=

# Claude API key for the agents (or use `ant auth login`)
ANTHROPIC_API_KEY=

# Worker HTTP port (serves deliverables + health)
WORKER_PORT=8787
